import { useState, useMemo } from 'react';
import './ExerciseLibrary.css';

/* ─── Datos iniciales ─────────────────────────────────────── */
const INITIAL_EXERCISES = [
  {
    id: 1,
    name: 'Press Banca',
    category: 'Tren Superior',
    videoUrl: 'https://www.youtube.com/watch?v=rT7DgCr-3pg',
    descripcion: 'Ejercicio compuesto de tren superior que trabaja principalmente el pectoral mayor, tríceps y deltoides anterior. Mantén los pies apoyados en el suelo y la espalda en contacto con el banco.',
  },
  {
    id: 2,
    name: 'Sentadilla Trasera',
    category: 'Tren Inferior',
    videoUrl: 'https://www.youtube.com/watch?v=ultWZbUMPL8',
    descripcion: 'Movimiento fundamental de tren inferior que activa cuádriceps, glúteos e isquiotibiales. Mantén el torso erguido, rodillas alineadas con los pies y desciende hasta paralelo.',
  },
  {
    id: 3,
    name: 'Plancha Abdominal',
    category: 'Core',
    videoUrl: 'https://www.youtube.com/watch?v=pSHjTRCQxIw',
    descripcion: 'Ejercicio isométrico de estabilización del core. Mantén el cuerpo en línea recta de cabeza a talones, contrae el abdomen y respira de forma controlada durante el tiempo indicado.',
  },
  {
    id: 4,
    name: 'Dominadas',
    category: 'Tren Superior',
    videoUrl: 'https://www.youtube.com/watch?v=eGo4IYlbE5g',
    descripcion: 'Ejercicio de tracción vertical que desarrolla el dorsal ancho, bíceps y romboides. Agarre supino o prono, baja hasta extensión completa y sube hasta que la barbilla supere la barra.',
  },
  {
    id: 5,
    name: 'Peso Muerto Rumano',
    category: 'Tren Inferior',
    videoUrl: 'https://www.youtube.com/watch?v=JCXUYuzwNrM',
    descripcion: 'Variante de bisagra de cadera que enfatiza los isquiotibiales y glúteos. Mantén las rodillas ligeramente flexionadas, espalda neutra y desciende la barra pegada a las piernas.',
  },
];

const INITIAL_CATEGORIES = ['Tren Superior', 'Tren Inferior', 'Core'];

/* ─── Helpers ─────────────────────────────────────────────── */
let nextId = INITIAL_EXERCISES.length + 1;

/**
 * Extrae el ID de vídeo de una URL de YouTube (formatos watch?v= y youtu.be/)
 * y devuelve la URL de la miniatura en alta calidad de la CDN oficial.
 */
function getYouTubeThumbnail(videoUrl) {
  if (!videoUrl) return null;
  try {
    const url = new URL(videoUrl);
    let videoId = null;
    if (url.hostname === 'youtu.be') {
      videoId = url.pathname.slice(1);
    } else if (url.hostname.includes('youtube.com')) {
      videoId = url.searchParams.get('v');
    }
    if (!videoId) return null;
    // hqdefault = 480×360, siempre disponible
    return `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`;
  } catch {
    return null;
  }
}

/**
 * Construye la URL de embed de YouTube (necesaria para el iframe).
 */
function getYouTubeEmbedUrl(videoUrl) {
  if (!videoUrl) return null;
  try {
    const url = new URL(videoUrl);
    let videoId = null;
    if (url.hostname === 'youtu.be') {
      videoId = url.pathname.slice(1);
    } else if (url.hostname.includes('youtube.com')) {
      videoId = url.searchParams.get('v');
    }
    if (!videoId) return null;
    return `https://www.youtube.com/embed/${videoId}?rel=0&modestbranding=1`;
  } catch {
    return null;
  }
}

function getCategoryBadgeClass(category) {
  const map = {
    'Tren Superior': 'badge--blue',
    'Tren Inferior': 'badge--green',
    'Core':          'badge--amber',
  };
  return map[category] || 'badge--default';
}

/* ─── Sub-componente: Miniatura de vídeo ─────────────────── */
function VideoThumbnail({ videoUrl, name }) {
  const [imgError, setImgError] = useState(false);
  const thumbnailUrl = getYouTubeThumbnail(videoUrl);
  const showImg = thumbnailUrl && !imgError;

  return (
    <div className="el__card-img-wrap">
      {showImg && (
        <img
          src={thumbnailUrl}
          alt={`Miniatura de ${name}`}
          className="el__card-img"
          loading="lazy"
          onError={() => setImgError(true)}
        />
      )}

      {/* Overlay con botón play — siempre visible si hay imagen */}
      {showImg && (
        <div className="el__card-play-overlay" aria-hidden="true">
          <span className="el__card-play-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </span>
        </div>
      )}

      {/* Fallback si no hay URL o falla la carga */}
      {!showImg && (
        <div className="el__card-img-fallback">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--gray-300)" strokeWidth="1.5" strokeLinecap="round">
            <rect x="2" y="6" width="20" height="14" rx="3"/>
            <path d="M8 10l6 4-6 4V10z" fill="var(--gray-200)" stroke="none"/>
          </svg>
          <span>Sin vídeo</span>
        </div>
      )}
    </div>
  );
}

/* ─── Sub-componente: Modal de Detalle de Ejercicio ─────── */
function ExerciseDetailModal({ exercise, onClose }) {
  const embedUrl = getYouTubeEmbedUrl(exercise.videoUrl);

  /* Cerrar con tecla Escape */
  useState(() => {
    function onKey(e) { if (e.key === 'Escape') onClose(); }
    document.addEventListener('keydown', onKey);
    return () => document.removeEventListener('keydown', onKey);
  });

  function handleOverlay(e) {
    if (e.target === e.currentTarget) onClose();
  }

  return (
    <div
      className="el__modal-overlay el__modal-overlay--detail"
      role="dialog"
      aria-modal="true"
      aria-labelledby="detail-title"
      onClick={handleOverlay}
    >
      <div className="el__detail-modal">

        {/* ── Vídeo embed ── */}
        <div className="el__detail-video-wrap">
          {embedUrl ? (
            <iframe
              className="el__detail-iframe"
              src={embedUrl}
              title={`Vídeo: ${exercise.name}`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowFullScreen
            />
          ) : (
            <div className="el__detail-no-video">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--gray-300)" strokeWidth="1.5" strokeLinecap="round">
                <rect x="2" y="6" width="20" height="14" rx="3"/>
                <path d="M8 10l6 4-6 4V10z" fill="var(--gray-200)" stroke="none"/>
              </svg>
              <span>Sin vídeo disponible</span>
            </div>
          )}

          {/* Botón cerrar flotante sobre el vídeo */}
          <button
            className="el__detail-close"
            onClick={onClose}
            aria-label="Cerrar panel de detalle"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>

        {/* ── Info ── */}
        <div className="el__detail-body">
          <div className="el__detail-meta">
            <span className={`badge ${getCategoryBadgeClass(exercise.category)}`}>
              {exercise.category}
            </span>
          </div>
          <h2 id="detail-title" className="el__detail-name">{exercise.name}</h2>
          {exercise.descripcion && (
            <p className="el__detail-desc">{exercise.descripcion}</p>
          )}

          <div className="el__detail-footer">
            {exercise.videoUrl && (
              <a
                href={exercise.videoUrl}
                target="_blank"
                rel="noopener noreferrer"
                className="el__btn el__btn--ghost el__detail-yt-link"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23 7s-.3-2-1.2-2.8c-1.1-1.2-2.4-1.2-3-1.3C16.1 2.8 12 2.8 12 2.8s-4.1 0-6.8.1c-.6.1-1.9.1-3 1.3C1.3 5 1 7 1 7S.7 9.1.7 11.2v2c0 2.1.3 4.2.3 4.2s.3 2 1.2 2.8c1.1 1.2 2.6 1.1 3.3 1.2C7.2 21.6 12 21.6 12 21.6s4.1 0 6.8-.2c.6-.1 1.9-.1 3-1.3.9-.8 1.2-2.8 1.2-2.8s.3-2.1.3-4.2v-2C23.3 9.1 23 7 23 7zM9.7 15.5V8.4l8.1 3.6-8.1 3.5z"/>
                </svg>
                Ver en YouTube
              </a>
            )}
            <button
              className="el__btn el__btn--primary"
              onClick={onClose}
              id="btn-close-detail"
            >
              Cerrar
            </button>
          </div>
        </div>

      </div>
    </div>
  );
}

/* ─── Sub-componente: Modal de Gestión de Categorías ────── */
function CategoryManagerModal({ categories, onClose, onAdd, onRename }) {
  const [newName, setNewName]       = useState('');
  const [newError, setNewError]     = useState('');
  const [editingIdx, setEditingIdx] = useState(null);
  const [editDraft, setEditDraft]   = useState('');
  const [editError, setEditError]   = useState('');

  function handleOverlay(e) {
    if (e.target === e.currentTarget) onClose();
  }

  function handleAdd(e) {
    e.preventDefault();
    const trimmed = newName.trim();
    if (!trimmed) { setNewError('El nombre no puede estar vacío.'); return; }
    if (categories.some(c => c.toLowerCase() === trimmed.toLowerCase())) {
      setNewError('Ya existe una categoría con ese nombre.'); return;
    }
    onAdd(trimmed);
    setNewName('');
    setNewError('');
  }

  function startEdit(idx) {
    setEditingIdx(idx);
    setEditDraft(categories[idx]);
    setEditError('');
  }

  function cancelEdit() {
    setEditingIdx(null);
    setEditDraft('');
    setEditError('');
  }

  function saveEdit(idx) {
    const trimmed = editDraft.trim();
    if (!trimmed) { setEditError('El nombre no puede estar vacío.'); return; }
    if (categories.some((c, i) => i !== idx && c.toLowerCase() === trimmed.toLowerCase())) {
      setEditError('Ya existe una categoría con ese nombre.'); return;
    }
    onRename(categories[idx], trimmed);
    cancelEdit();
  }

  return (
    <div
      className="el__modal-overlay"
      role="dialog"
      aria-modal="true"
      aria-labelledby="cat-modal-title"
      onClick={handleOverlay}
    >
      <div className="el__modal el__modal--wide">
        <div className="el__modal-header">
          <h2 id="cat-modal-title" className="el__modal-title el__modal-title--icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/>
              <line x1="7" y1="7" x2="7.01" y2="7"/>
            </svg>
            Gestionar Categorías
          </h2>
          <button
            className="el__modal-close"
            onClick={onClose}
            aria-label="Cerrar gestión de categorías"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>

        <div className="el__modal-form">

          {/* ── Categorías existentes ── */}
          <div className="el__cat-section">
            <p className="el__cat-section-label">Categorías existentes</p>
            <ul className="el__cat-list" role="list">
              {categories.map((cat, idx) => (
                <li key={cat} className="el__cat-item">
                  {editingIdx === idx ? (
                    <>
                      <div className="el__cat-edit-row">
                        <input
                          className={`el__input el__cat-input ${editError ? 'el__input--error' : ''}`}
                          value={editDraft}
                          onChange={e => { setEditDraft(e.target.value); setEditError(''); }}
                          onKeyDown={e => {
                            if (e.key === 'Enter') { e.preventDefault(); saveEdit(idx); }
                            if (e.key === 'Escape') cancelEdit();
                          }}
                          autoFocus
                          aria-label={`Renombrar ${cat}`}
                        />
                        <button
                          className="el__cat-action-btn el__cat-action-btn--save"
                          onClick={() => saveEdit(idx)}
                          title="Guardar"
                          aria-label="Guardar nombre"
                        >
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round">
                            <polyline points="20 6 9 17 4 12"/>
                          </svg>
                        </button>
                        <button
                          className="el__cat-action-btn el__cat-action-btn--cancel"
                          onClick={cancelEdit}
                          title="Cancelar"
                          aria-label="Cancelar edición"
                        >
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round">
                            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                          </svg>
                        </button>
                      </div>
                      {editError && <p className="el__field-error el__cat-error">{editError}</p>}
                    </>
                  ) : (
                    <div className="el__cat-display-row">
                      <span className={`badge ${getCategoryBadgeClass(cat)}`}>{cat}</span>
                      <button
                        className="el__cat-edit-trigger"
                        onClick={() => startEdit(idx)}
                        aria-label={`Renombrar ${cat}`}
                      >
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                          <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                          <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                        </svg>
                        Renombrar
                      </button>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>

          {/* ── Nueva categoría ── */}
          <div className="el__cat-section el__cat-section--add">
            <p className="el__cat-section-label">Nueva categoría</p>
            <form onSubmit={handleAdd} className="el__cat-add-row" noValidate>
              <input
                id="new-cat-input"
                type="text"
                className={`el__input ${newError ? 'el__input--error' : ''}`}
                placeholder="ej. Movilidad, Cardio…"
                value={newName}
                onChange={e => { setNewName(e.target.value); setNewError(''); }}
                aria-label="Nombre de la nueva categoría"
              />
              <button type="submit" className="el__btn el__btn--primary" id="btn-add-category">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round">
                  <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Añadir
              </button>
            </form>
            {newError && <p className="el__field-error">{newError}</p>}
          </div>

        </div>
      </div>
    </div>
  );
}

/* ─── Componente Principal ────────────────────────────────── */
export default function ExerciseLibrary() {
  /* Estado de ejercicios */
  const [exercises, setExercises]     = useState(INITIAL_EXERCISES);

  /* Búsqueda y filtros */
  const [search, setSearch]           = useState('');
  const [category, setCategory]       = useState('Todas');

  /* Selección para bloques */
  const [selected, setSelected]       = useState(new Set());
  const [blocks, setBlocks]           = useState([]);

  /* Categorías dinámicas */
  const [categories, setCategories]     = useState(INITIAL_CATEGORIES);
  const [showCatModal, setShowCatModal] = useState(false);

  /* Modal de añadir ejercicio */
  const [showModal, setShowModal]     = useState(false);
  const [form, setForm]               = useState({ name: '', category: INITIAL_CATEGORIES[0], videoUrl: '' });
  const [formError, setFormError]     = useState('');

  /* Modal de detalle de ejercicio */
  const [detailEx, setDetailEx]       = useState(null);

  /* Panel de bloques */
  const [showBlocks, setShowBlocks]   = useState(false);

  /* ── Ejercicios filtrados ── */
  const filtered = useMemo(() => {
    return exercises.filter((ex) => {
      const matchName = ex.name.toLowerCase().includes(search.toLowerCase());
      const matchCat  = category === 'Todas' || ex.category === category;
      return matchName && matchCat;
    });
  }, [exercises, search, category]);

  /* ── Selección toggle ── */
  function toggleSelect(id) {
    setSelected((prev) => {
      const next = new Set(prev);
      if (next.has(id)) {
        next.delete(id);
      } else {
        if (next.size >= 3) return prev; // máximo 3
        next.add(id);
      }
      return next;
    });
  }

  /* ── Crear bloque ── */
  function handleCreateBlock() {
    if (selected.size < 2) return;
    const exs = exercises.filter((e) => selected.has(e.id));
    setBlocks((prev) => [
      ...prev,
      { id: Date.now(), exercises: exs },
    ]);
    setSelected(new Set());
  }

  /* ── Añadir ejercicio ── */
  function handleAddExercise(e) {
    e.preventDefault();
    if (!form.name.trim()) {
      setFormError('El nombre es obligatorio.');
      return;
    }
    setExercises((prev) => [
      ...prev,
      { id: nextId++, name: form.name.trim(), category: form.category, videoUrl: form.videoUrl.trim() },
    ]);
    setForm({ name: '', category: 'Tren Superior', videoUrl: '' });
    setFormError('');
    setShowModal(false);
  }

  /* ── Cerrar modal al hacer clic fuera ── */
  function handleOverlayClick(e) {
    if (e.target === e.currentTarget) {
      setShowModal(false);
      setFormError('');
    }
  }

  /* ── Gestión de categorías ── */
  function handleAddCategory(name) {
    setCategories(prev => [...prev, name]);
  }

  function handleRenameCategory(oldName, newName) {
    // Actualizar lista de categorías
    setCategories(prev => prev.map(c => c === oldName ? newName : c));
    // Renombrar en todos los ejercicios que la tenían
    setExercises(prev =>
      prev.map(ex => ex.category === oldName ? { ...ex, category: newName } : ex)
    );
    // Actualizar el formulario si tenía esa categoría seleccionada
    setForm(prev => prev.category === oldName ? { ...prev, category: newName } : prev);
    // Actualizar el filtro activo si filtraba por esa categoría
    setCategory(prev => prev === oldName ? newName : prev);
  }

  return (
    <section className="el" aria-label="Librería de Ejercicios">

      {/* ══ CABECERA ══════════════════════════════════════════ */}
      <header className="el__header">
        <div className="el__title-group">
          <h1 className="el__title">Librería de Ejercicios</h1>
          <p className="el__subtitle">
            {exercises.length} ejercicios · {blocks.length} bloque{blocks.length !== 1 ? 's' : ''} creado{blocks.length !== 1 ? 's' : ''}
          </p>
        </div>

        <div className="el__header-actions">
          {/* Botón Bloques Creados */}
          <button
            id="btn-show-blocks"
            className={`el__btn el__btn--ghost ${showBlocks ? 'el__btn--ghost-active' : ''}`}
            onClick={() => setShowBlocks((v) => !v)}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <rect x="3" y="3" width="7" height="7" rx="1.5"/>
              <rect x="14" y="3" width="7" height="7" rx="1.5"/>
              <rect x="3" y="14" width="7" height="7" rx="1.5"/>
              <rect x="14" y="14" width="7" height="7" rx="1.5"/>
            </svg>
            Bloques <span className="el__btn-badge">{blocks.length}</span>
          </button>

          {/* Botón Añadir Ejercicio */}
          <button
            id="btn-add-exercise"
            className="el__btn el__btn--primary"
            onClick={() => setShowModal(true)}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Añadir Ejercicio
          </button>
        </div>
      </header>

      {/* ══ PANEL BLOQUES CREADOS ════════════════════════════ */}
      {showBlocks && (
        <div className="el__blocks-panel">
          <h2 className="el__blocks-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
            </svg>
            Bloques Creados
          </h2>
          {blocks.length === 0 ? (
            <p className="el__blocks-empty">Aún no hay bloques. Selecciona 2–3 ejercicios y pulsa «Crear Bloque».</p>
          ) : (
            <div className="el__blocks-list">
              {blocks.map((block, i) => (
                <div key={block.id} className="el__block-card">
                  <span className="el__block-label">Bloque {i + 1}</span>
                  <div className="el__block-exs">
                    {block.exercises.map((ex) => (
                      <span key={ex.id} className="el__block-ex-tag">
                        <span className={`badge ${getCategoryBadgeClass(ex.category)}`}>{ex.category[0]}</span>
                        {ex.name}
                      </span>
                    ))}
                  </div>
                  <button
                    className="el__block-delete"
                    title="Eliminar bloque"
                    onClick={() => setBlocks((prev) => prev.filter((b) => b.id !== block.id))}
                    aria-label={`Eliminar bloque ${i + 1}`}
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round">
                      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                  </button>
                </div>
              ))}
            </div>
          )}
        </div>
      )}

      {/* ══ BARRA DE BÚSQUEDA Y FILTROS ═════════════════════ */}
      <div className="el__toolbar">
        {/* Search */}
        <div className="el__search-wrap">
          <svg className="el__search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            id="search-exercises"
            type="text"
            className="el__search"
            placeholder="Buscar ejercicio…"
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            aria-label="Buscar ejercicios por nombre"
          />
          {search && (
            <button className="el__search-clear" onClick={() => setSearch('')} aria-label="Limpiar búsqueda">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          )}
        </div>

        {/* Categoría */}
        <div className="el__select-wrap">
          <svg className="el__select-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round">
            <line x1="21" y1="6" x2="3" y2="6"/><line x1="17" y1="12" x2="7" y2="12"/><line x1="13" y1="18" x2="11" y2="18"/>
          </svg>
          <select
            id="filter-category"
            className="el__select"
            value={category}
            onChange={(e) => setCategory(e.target.value)}
            aria-label="Filtrar por categoría"
          >
            {['Todas', ...categories].map((c) => (
              <option key={c} value={c}>{c}</option>
            ))}
          </select>
        </div>

        {/* Gestionar Categorías */}
        <button
          id="btn-manage-categories"
          className={`el__btn el__btn--ghost ${showCatModal ? 'el__btn--ghost-active' : ''}`}
          onClick={() => setShowCatModal(true)}
          title="Crear, editar y organizar categorías"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/>
            <line x1="7" y1="7" x2="7.01" y2="7"/>
          </svg>
          Gestionar Categorías
        </button>

        {/* Crear Bloque */}
        <button
          id="btn-create-block"
          className={`el__btn el__btn--block ${selected.size >= 2 ? 'el__btn--block-ready' : ''}`}
          disabled={selected.size < 2}
          onClick={handleCreateBlock}
          title={selected.size < 2 ? 'Selecciona al menos 2 ejercicios' : 'Crear bloque con los ejercicios seleccionados'}
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
          </svg>
          Crear Bloque
          {selected.size > 0 && (
            <span className="el__btn-badge el__btn-badge--dark">{selected.size}/3</span>
          )}
        </button>
      </div>

      {/* ══ GRID DE EJERCICIOS ══════════════════════════════ */}
      {filtered.length === 0 ? (
        <div className="el__empty">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--gray-300)" strokeWidth="1.5" strokeLinecap="round">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <p>No se encontraron ejercicios.</p>
          <span>Prueba otro término o cambia el filtro.</span>
        </div>
      ) : (
        <div className="el__grid" role="list">
          {filtered.map((ex) => {
            const isSelected = selected.has(ex.id);
            return (
              <article
                key={ex.id}
                className={`el__card ${isSelected ? 'el__card--selected' : ''}`}
                role="listitem"
                aria-selected={isSelected}
              >
                {/* Checkbox de selección */}
                <button
                  className={`el__card-check ${isSelected ? 'el__card-check--on' : ''}`}
                  onClick={() => toggleSelect(ex.id)}
                  aria-label={isSelected ? `Deseleccionar ${ex.name}` : `Seleccionar ${ex.name}`}
                  title={!isSelected && selected.size >= 3 ? 'Máximo 3 ejercicios por bloque' : ''}
                >
                  {isSelected ? (
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                  ) : (
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round">
                      <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                  )}
                </button>

                {/* Miniatura de vídeo — clic abre el detalle */}
                <button
                  className="el__card-thumb-btn"
                  onClick={() => setDetailEx(ex)}
                  aria-label={`Ver detalle de ${ex.name}`}
                  tabIndex={0}
                >
                  <VideoThumbnail videoUrl={ex.videoUrl} name={ex.name} />
                </button>

                {/* Cuerpo de tarjeta */}
                <div className="el__card-body">
                  <span className={`badge ${getCategoryBadgeClass(ex.category)}`}>{ex.category}</span>
                  <h3 className="el__card-name">{ex.name}</h3>
                </div>

                {/* Footer — botón abre detalle */}
                <div className="el__card-footer">
                  <button
                    className="el__video-link"
                    onClick={() => setDetailEx(ex)}
                    aria-label={`Ver detalle de ${ex.name}`}
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                    Ver Vídeo
                  </button>
                </div>
              </article>
            );
          })}
        </div>
      )}

      {/* ══ MODAL DETALLE EJERCICIO ═════════════════════════ */}
      {detailEx && (
        <ExerciseDetailModal
          exercise={detailEx}
          onClose={() => setDetailEx(null)}
        />
      )}

      {/* ══ MODAL GESTIONAR CATEGORÍAS ══════════════════════ */}
      {showCatModal && (
        <CategoryManagerModal
          categories={categories}
          onClose={() => setShowCatModal(false)}
          onAdd={handleAddCategory}
          onRename={handleRenameCategory}
        />
      )}

      {/* ══ MODAL AÑADIR EJERCICIO ═══════════════════════════ */}
      {showModal && (
        <div
          className="el__modal-overlay"
          role="dialog"
          aria-modal="true"
          aria-labelledby="modal-title"
          onClick={handleOverlayClick}
        >
          <div className="el__modal">
            <div className="el__modal-header">
              <h2 id="modal-title" className="el__modal-title">Nuevo Ejercicio</h2>
              <button
                className="el__modal-close"
                onClick={() => { setShowModal(false); setFormError(''); }}
                aria-label="Cerrar modal"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round">
                  <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
              </button>
            </div>

            <form className="el__modal-form" onSubmit={handleAddExercise} noValidate>
              {/* Nombre */}
              <div className="el__field">
                <label htmlFor="field-name" className="el__label">Nombre *</label>
                <input
                  id="field-name"
                  type="text"
                  className={`el__input ${formError ? 'el__input--error' : ''}`}
                  placeholder="ej. Press Militar"
                  value={form.name}
                  onChange={(e) => { setForm((f) => ({ ...f, name: e.target.value })); setFormError(''); }}
                  autoFocus
                />
                {formError && <p className="el__field-error">{formError}</p>}
              </div>

              {/* Categoría */}
              <div className="el__field">
                <label htmlFor="field-category" className="el__label">Categoría</label>
                <select
                  id="field-category"
                  className="el__input el__input--select"
                  value={form.category}
                  onChange={(e) => setForm((f) => ({ ...f, category: e.target.value }))}
                >
                  {categories.map((c) => (
                    <option key={c} value={c}>{c}</option>
                  ))}
                </select>
              </div>

              {/* Enlace de vídeo */}
              <div className="el__field">
                <label htmlFor="field-video" className="el__label">Enlace del vídeo</label>
                <input
                  id="field-video"
                  type="url"
                  className="el__input"
                  placeholder="https://youtube.com/…"
                  value={form.videoUrl}
                  onChange={(e) => setForm((f) => ({ ...f, videoUrl: e.target.value }))}
                />
              </div>

              <div className="el__modal-actions">
                <button
                  type="button"
                  className="el__btn el__btn--ghost"
                  onClick={() => { setShowModal(false); setFormError(''); }}
                >
                  Cancelar
                </button>
                <button type="submit" className="el__btn el__btn--primary" id="btn-save-exercise">
                  Guardar Ejercicio
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </section>
  );
}
