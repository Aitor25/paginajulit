rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return isAuthenticated() && exists(userPath());
    }

    function getUserData() {
      return get(userPath()).data;
    }

    function isBootstrapOwner() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'agarciah10@gmail.com';
    }

    function isOwner() {
      return userExists() && getUserData().role == 'owner';
    }

    function isCoach() {
      return userExists()
        && (
          getUserData().role == 'coach'
          || getUserData().role == 'owner'
        );
    }

    function isClient() {
      return userExists() && getUserData().role == 'client';
    }

    function belongsToOrganization(orgId) {
      return userExists()
        && getUserData().organizationId == orgId;
    }

    function isInitialClientRegistration(userId) {
      return isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'client'
        && request.resource.data.clientId == null
        && request.resource.data.organizationId == null
        && request.resource.data.status == 'pending_assignment';
    }

    match /users/{userId} {

      // El usuario puede leer su propio documento aunque todavía
      // no tenga perfil previo. Owner y coach pueden leer usuarios.
      allow get: if isAuthenticated()
        && (
          request.auth.uid == userId
          || isCoach()
          || isBootstrapOwner()
        );

      // Solo los Owners pueden listar la colección completa.
      // (Coaches leerán perfiles específicos pero no listarán libremente).
      allow list: if isOwner();

      // Creación: o es el owner inicial configurándose a sí mismo, o es un cliente normal
      allow create: if isInitialClientRegistration(userId) 
        || (isBootstrapOwner() && request.auth.uid == userId);

      // El usuario puede modificar ciertos datos de su perfil (ej. fullName, avatar),
      // pero no puede alterar los campos críticos de autorización, a menos que sea el bootstrap owner.
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && (
          isBootstrapOwner()
          || (
            request.resource.data.uid == resource.data.uid
            && request.resource.data.email == resource.data.email
            && request.resource.data.role == resource.data.role
            && request.resource.data.organizationId == resource.data.organizationId
            && request.resource.data.clientId == resource.data.clientId
            && request.resource.data.status == resource.data.status
          )
        );

      // Owner puede gestionar perfiles de su organización libremente. Coach no puede cambiar roles.
      allow update: if isOwner();

      allow delete: if isOwner();
    }

    match /organizations/{orgId} {
      allow get: if isAuthenticated()
        && (
          belongsToOrganization(orgId)
          || isOwner()
          || isBootstrapOwner()
        );

      allow list: if isOwner();

      // Solo el bootstrap owner o un owner pueden crear la organización
      allow create: if (isBootstrapOwner() && orgId == 'julit') || isOwner();

      allow update, delete: if isOwner()
        && belongsToOrganization(orgId);
    }

    match /clients/{clientId} {
      allow read: if isCoach()
        || (
          isClient()
          && resource.data.linkedUserId == request.auth.uid
        );

      allow create, update, delete: if isCoach();
    }

    match /programs/{programId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isCoach();
    }

    match /program_assignments/{assignmentId} {
      allow read: if isCoach()
        || (
          isClient()
          && resource.data.clientId == getUserData().clientId
        );

      allow create, update, delete: if isCoach();
    }

    match /workouts/{workoutId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isCoach();
    }

    match /workout_assignments/{assignmentId} {
      allow read: if isCoach()
        || (
          isClient()
          && resource.data.clientId == getUserData().clientId
        );

      allow create, update, delete: if isCoach();
    }

    match /workout_results/{resultId} {
      allow read: if isCoach()
        || (
          isClient()
          && resource.data.clientId == getUserData().clientId
        );

      allow create: if isCoach()
        || (
          isClient()
          && request.resource.data.clientId == getUserData().clientId
        );

      allow update: if isCoach()
        || (
          isClient()
          && resource.data.clientId == getUserData().clientId
          && request.resource.data.clientId == resource.data.clientId
        );

      allow delete: if isCoach();
    }

    match /assessments/{assessmentId} {
      allow read: if isCoach()
        || (
          isClient()
          && resource.data.clientId == getUserData().clientId
        );

      allow create, update, delete: if isCoach();
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isCoach();
    }

    // Denegación por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}