rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Función auxiliar para obtener los datos del usuario autenticado desde Firestore
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Funciones auxiliares para verificar roles
    function isOwner() {
      return isAuthenticated() && getUserData().role == 'owner';
    }

    function isCoach() {
      return isAuthenticated() && (getUserData().role == 'coach' || getUserData().role == 'owner');
    }

    function isClient() {
      return isAuthenticated() && getUserData().role == 'client';
    }

    // Colección: users
    match /users/{userId} {
      // Un usuario puede leer su propio perfil.
      // Un coach puede leer el perfil de cualquier usuario en la app (necesario para ver clientes).
      allow read: if isAuthenticated() && (request.auth.uid == userId || isCoach());
      // Solo el propio usuario puede actualizar su perfil (o el coach si es necesario)
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Colección: organizations
    match /organizations/{orgId} {
      // Todos pueden leer organizaciones a las que pertenecen
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    // Colección: clients
    match /clients/{clientId} {
      // client user profile may not have clientId injected directly yet if they just registered.
      // So let's allow read if the client document linkedUserId matches uid
      allow read: if isCoach() || (isClient() && resource.data.linkedUserId == request.auth.uid);
      allow write: if isCoach();
    }

    // Colección: programs
    match /programs/{programId} {
      allow read: if isAuthenticated();
      allow write: if isCoach();
    }

    // Colección: program_assignments
    match /program_assignments/{assignmentId} {
      // Si clientId está en los datos del usuario
      allow read: if isCoach() || (isClient() && resource.data.clientId == getUserData().clientId);
      allow write: if isCoach();
    }

    // Colección: workouts
    match /workouts/{workoutId} {
      allow read: if isAuthenticated();
      allow write: if isCoach();
    }

    // Colección: workout_assignments
    match /workout_assignments/{assignmentId} {
      allow read: if isCoach() || (isClient() && resource.data.clientId == getUserData().clientId);
      allow write: if isCoach();
    }

    // Colección: workout_results
    match /workout_results/{resultId} {
      allow read: if isCoach() || (isClient() && resource.data.clientId == getUserData().clientId);
      // El cliente sí puede escribir sus resultados
      allow write: if isCoach() || (isClient() && request.resource.data.clientId == getUserData().clientId);
    }

    // Colección: assessments
    match /assessments/{assessmentId} {
      allow read: if isCoach() || (isClient() && resource.data.clientId == getUserData().clientId);
      allow write: if isCoach();
    }

    // Colección: settings
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isCoach();
    }

    // Para cualquier otra colección de catálogo (ej. exercises, categories, materials)
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isCoach();
    }
  }
}
